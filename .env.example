# Copy this file to .env and fill in your own values. Never commit .env.

# Gmail account that sends OTP and security-alert emails.
# GMAIL_APP_PASSWORD is a 16-character Google App Password, not your normal password.
GMAIL_ADDRESS=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Abstract API "Phone Intelligence" key, used by monitor.py for carrier lookup
ABSTRACT_API_KEY=

# Optional Twilio Lookup fallback for non-Indian numbers (leave blank if unused)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
